# Wi-Fi
WIFI_SSID = ""
WIFI_PASSWORD = ""

# MQTT
MQTT_BROKER = "10.10.0.43"  # eth, zero@uni (pi5) — vždy IP adresa, ne hostname (hostname blokuje WDT při DNS timeoutu)
MQTT_PORT = 1883
MQTT_CLIENT_ID = "pico_L200h"
MQTT_KEEPALIVE = 60          # [s] keepalive interval pro broker
MQTT_STATUS_TOPIC = "sensor/L200h/status"  # LWT a online status
MQTT_USER = None             # MQTT username (None = anonymní přístup)
MQTT_PASSWORD = None         # MQTT heslo

# I2C piny
I2C_ID = 1              # 0 = I2C0, 1 = I2C1
I2C_SDA = 26
I2C_SCL = 27
I2C_FREQ = 400_000

# Display
TM_CLK = 3
TM_DIO = 2
DISPLAY_SENSOR = 0  # index senzoru pro zobrazení na displeji (0 = první)
BUTTON_PIN = 14    # pin pro přepínání displeje tlačítkem (None = deaktivováno)

# Sdílené ADC nastavení
ADC_ADDRESS = 0x48  # I2C adresa ADS1115 (0x48-0x4B podle ADDR pinu)
ADC_GAIN = 2        # ±2.048 V
ADC_RATE = 3        # 64 SPS
ADC_SAMPLES = 5     # počet vzorků pro průměr

# Interval měření [s]
INTERVAL_S = 1

# Watchdog timeout [ms]
WDT_TIMEOUT_MS = 8000

# Max počet zpráv v zásobníku pro neodeslané MQTT hodnoty
PUBLISH_BUFFER_MAX = 200

# Diagnostika (0 = vypnuto)
DIAG_INTERVAL = 60                     # publikovat každých N cyklů
DIAG_TOPIC = "diag/L200h"              # MQTT topic pro diagnostiku

# Seznam senzorů s per-senzor konfigurací
SENSORS = [
    {
        "type": "current_loop",      # typ převodu
        "channel": 0,                # ADC kanál
        "topic": "sensor/L200h/p1" , # MQTT topic
        "name": "p1",                # pro debug
        # Parametry specifické pro current_loop:
        "led_pin": 15,     # pin pro LED indikátor aktivního senzoru (None = bez LED)
        "r_bocnik": 99.1,  # [Ohm]
        "i_min": 0.004,  # [A]
        "i_max": 0.020,  # [A]
        "i_disconnect": 0.001,  # [A] pod = E-nc (odpojený senzor); None vypne kontrolu
        "p_min": 0,      # [kPa]
        "p_max": 120,    # [kPa]
        "precision": 3,  # počet desetinných míst pro MQTT
    },
    {
        "type": "pirani",            # Pirani vakuometr
        "channel": 1,
        "topic": "sensor/L200h/pirani",
        "led_pin": 16,     # pin pro LED indikátor aktivního senzoru (None = bez LED)
        "name": "Pirani",
        # Regresní koeficienty: p = exp(a + b*u + c*sqrt(u)) [mbar], [u - 0-10V]
        "a": -6.435,
        "b": 0.7418,
        "c": 0.8018,
        "u_divider": 5.009,  # koeficient děliče (u_actual = u_meas * u_divider)
        "u_min": 0.0,    # [V] min. změřené napětí za děličem (pod = ERR_LO)
        "u_max": 2.0,  # [V] max. změřené napětí za děličem (nad = ERR_HI)
        "p_min": 1e-4,   # [mbar] min. tlak (pod = ERR_LO)
        "p_max": 1000.0, # [mbar] max. tlak (nad = ERR_HI)
        "precision": 3,  # počet desetinných míst pro MQTT
    },
]
